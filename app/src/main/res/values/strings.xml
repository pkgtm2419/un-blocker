    <!-- Beyond DNS dialog & card -->
    <string name="beyond_dns_dialog_title">Beyond DNS: Streams &amp; Feeds</string>
    <string name="beyond_dns_dialog_subtitle">Defense-in-depth for video &amp; in-app ads</string>
    <string name="beyond_dns_dialog_intro">DNS filtering blocks 80–90% of ads and telemetry before connections start. However, some ads share identical domains with media content. Here is how to defeat them at other layers:</string>
    <string name="beyond_dns_youtube_title">YouTube &amp; Media Streams</string>
    <string name="beyond_dns_youtube_why">Video and ads are served from the same CDN (googlevideo.com). Blocking DNS crashes the player.</string>
    <string name="beyond_dns_youtube_solution">Use Firefox + uBlock Origin for web playback, or open-source players (NewPipe, Tubular, ReVanced) with SponsorBlock.</string>
    <string name="beyond_dns_youtube_action">Install Firefox</string>
    <string name="beyond_dns_web_title">Web Blank Frames &amp; Popups</string>
    <string name="beyond_dns_web_why">DNS drops ad connections, but websites leave empty blank frames behind.</string>
    <string name="beyond_dns_web_solution">Install Firefox with uBlock Origin or use Brave Browser with Shields. They inject CSS rules to collapse blank ad spaces and remove cookie popups.</string>
    <string name="beyond_dns_web_action">Install Brave</string>
    <string name="beyond_dns_social_title">Social Media In-Feed Promos</string>
    <string name="beyond_dns_social_desc">Instagram, Facebook, and Reddit feed ads arrive inside encrypted API responses. The safest solution without account ban risk is installing them as Progressive Web Apps (PWAs) inside Brave or Firefox with uBlock Origin.</string>
    <string name="beyond_dns_solution_format">✓ Solution: %1$s</string>
    <string name="beyond_dns_card_title">Beyond DNS: Video &amp; Stream Ads</string>
    <string name="beyond_dns_card_badge">Defense-in-Depth</string>
    <string name="beyond_dns_card_body">YouTube, Twitch, and social feed ads share content domains and bypass DNS. Learn how to combine Un-Blocker with Firefox, uBlock Origin, and PWAs.</string>
    <string name="beyond_dns_card_button">View Multi-Layer Setup Guide</string>

